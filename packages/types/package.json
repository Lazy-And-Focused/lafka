{
  "name": "@lafka/types",
  "version": "1.1.0",
  "description": "all types for lafka",
  "types": "index.d.ts",
  "main": "index.js",
  "private": false,
  "license": "MIT",
  "files": [
    "dist",
    "!./**/compiler.js",
    "!./**/compiler.d.ts"
  ],
  "scripts": {
    "build": "pnpm run compile && tsc && tsc-alias && pnpm run format && pnpm run remove-compiler",
    "compile": "set NODE_ENV=rights_compile&& ts-node ./src/rights.types.ts",
    "format": "prettier ./src/rights.types.ts -c -w",
    "remove-compiler": "rimraf ./dist/rights.compiler.d.ts && rimraf ./dist/rights.compiler.js"
  },
  "keywords": [
    "types",
    "lafka",
    "lazy-and-focused",
    "laf",
    "fockusty"
  ],
  "author": {
    "name": "Lazy-And-Focused",
    "url": "https://laf-team.ru/",
    "email": "laf.love.command@gmail.com"
  },
  "contributors": [
    {
      "name": "FOCKUSTY",
      "email": "viserd.yt@gmail.com",
      "url": "http://fockusty.netlify.app/"
    }
  ],
  "devDependencies": {
    "@types/node": "catalog:",
    "mongoose": "catalog:",
    "prettier": "catalog:",
    "rimraf": "^6.0.1",
    "ts-node": "catalog:",
    "tsc-alias": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "fbit-field": "1.4.0-alpha.1c"
  }
}
