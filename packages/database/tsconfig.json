{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2024",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    
    "declaration": true,
    "declarationDir": "./",
    "outDir": "./",

    "paths": {
      "@lafka/types/*": ["./src/types/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}